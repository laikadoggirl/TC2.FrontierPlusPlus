$name: "EC-EL Lightning Rifle"
$desc:
	'''
	Experimental rifle utilizing clip-batteries made of electricity pellets.

	Fires a bolt of hyper-focused tesla fire that stuns and burns through opponents.
	'''
$tags: []

body:
{	
	buoyancy: 0.050

	@shape.line:
	{
		a: [-1.125, 0.125]
		b: [1.000, -0.100]
		mass: 6.500
		radius: 0.320
		friction: 0.600
		elasticity: 0.450
		material: metal
		layer: entity, solid, ignore_bullet, ignore_melee, item, conductive, magnetic
		mask: world
	}
}

gun:
{
	muzzle_offset: [1.250, -0.0625]
	receiver_offset: [-0.500, -0.125]
	
	eject_direction: [-4.800, -5.400]
	eject_angular_velocity: 10.000
	
	shake_amount: 0.390
	
	sound_size: 3.000
	sound_dist_multiplier: 2.500
	
	sound_shoot: essence.collapse.electricity.00
	sound_cycle: essence.hit.bullet.00
	sound_reload: essence.push.00
	
	damage_multiplier: 2.600
	velocity_multiplier: 620.000
	velocity_max: 820.000
	jitter_multiplier: 0.290
	recoil_multiplier: 1.250
	muzzle_blast_mult: 1.100
	reload_interval: 0.600
	cycle_interval: 0.500
	stability: 1400.000
	failure_rate: 0.001
	
	ammo_filter: ammo_harpoon
	max_ammo: 3.000
	
	action: bolt
	type: rifle
	feed: clip
	
	heuristic_range: 50.000

	@inventory1:
	{
		stack_size_multiplier: 1.000
		type: ammo
		flags: hidden, ignore_mass, no_auto_pickup

		filter:
		{
			require: ammo
			exclude: gas
		}
	}
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [1.250, -0.125]
		scale: [24.000, 16.000]
		intensity: 0.000
		texture: "light.circle.00"
	}
}

gun.state:
{

}

holdable:
{
	offset: [-0.625, 0.125]
	radius: 4.000
	flags: storable

	force_multiplier: 2.800
	torque_multiplier: 1.950
}

animated.renderer:
{
	sprite:
	{
		texture: "lightningrifle"
		offset: [-0.125, 0.125]
	}
}

health:
{
	max: 3200.000
}

transform:
{

}

control:
{

}

aimable:
{
	min: -0.750
	max: 0.600
}

packable:
{

}

light:
{
	color: [0.650, 0.800, 1.000, 1.700]
	offset: [-0.1250, 0.000]
	scale: [3.000, 2.000]
	intensity: 1.000
	texture: "light.box.04"
}

sound.emitter:
{
	file: "essence.device.loop.00"
	volume: 0.400
	size: 1.000
	size_max_modifier: 1.000
	pitch: 1.100
}